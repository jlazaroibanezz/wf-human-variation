// Example site configuration for running wf-human-variation with Slurm
// and Apptainer/Singularity.
// Replace the partition names and shared-data bind path for your HPC system.
// Keep this file separate from the workflow's portable Nextflow configuration.

process {
    executor = 'slurm'
    queue = 'YOUR_STANDARD_PARTITION'

    // BAM concatenation and sorting
    withName: 'ingress:catSortBams' {
        cpus = 12
        memory = 16.GB
    }

    // Long-read alignment: use a high-memory partition
    withName: 'ingress:minimap2_alignment' {
        queue = 'YOUR_HIGH_MEMORY_PARTITION'
        cpus = 24
        memory = 128.GB
    }

    // Concatenate haplotagged contigs
    withName: 'snp:cat_haplotagged_contigs' {
        queue = 'YOUR_HIGH_MEMORY_PARTITION'
        cpus = 4
        memory = 128.GB
    }

    // bedMethyl concatenation and sorting
    withName: 'mod:concat_bedmethyl' {
        cpus = 4
        memory = 32.GB
        beforeScript = '''
            mkdir -p "$PWD/sort_tmp"
            export TMPDIR="$PWD/sort_tmp"
            export TMP="$PWD/sort_tmp"
            export TEMP="$PWD/sort_tmp"
        '''
    }

    // Retry Clair3 pileup with progressively more memory
    withName: 'snp:pileup_variants' {
        memory = { [7.GB, 14.GB, 21.GB][task.attempt - 1] }
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // Retry CNV mosdepth with progressively more memory
    withName: 'cnv_spectre:mosdepth' {
        memory = { [8.GB, 12.GB, 16.GB][task.attempt - 1] }
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // AnnotSV regulatory-element intersections require additional memory
    withName: 'ANNOTSV_SV' {
        memory = 16.GB
    }

    // Keep the default reference-decompression cache enabled.
}

// Limit the number of tasks submitted to Slurm simultaneously
executor {
    queueSize = 50
}

// Make shared annotation/reference resources visible inside containers.
// Replace this example with the shared path used by your HPC.
// Use read-only mounting for reference and annotation databases.
singularity {
    enabled = true
    autoMounts = true
    runOptions = '-B /path/to/shared/data:/path/to/shared/data:ro'
}
